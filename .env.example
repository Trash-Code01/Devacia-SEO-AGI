# =============================================================================
# Devacia SEO AGI — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Primary Website & Domain Configuration
# -----------------------------------------------------------------------------
# The canonical URL of the site to analyze, inspect, and optimize
SEO_SITE_URL=https://www.yourdomain.com

# Target property URL in Google Search Console (falls back to SEO_SITE_URL)
# Supports domain properties (sc-domain:yourdomain.com) or URL-prefix properties (https://yourdomain.com/)
GSC_SITE_URL=https://www.yourdomain.com

# -----------------------------------------------------------------------------
# 2. Google Analytics 4 (GA4) Configuration
# -----------------------------------------------------------------------------
# Numeric property ID (Found in Google Analytics: Admin -> Property Settings)
GA4_PROPERTY_ID=123456789

# -----------------------------------------------------------------------------
# 3. Google Business Profile (Local SEO Configuration)
# -----------------------------------------------------------------------------
GBP_BUSINESS_NAME=Your Business Name
GBP_PHONE=+1 555-123-4567
GBP_RAW_PHONE=5551234567
GBP_CITY=San Francisco
GBP_STATE=California
GBP_COUNTRY=United States
GBP_WEBSITE=https://www.yourdomain.com

# -----------------------------------------------------------------------------
# 4. Google Keyword Planner / Google Ads API (Optional)
# -----------------------------------------------------------------------------
# If omitted, GKP features use zero-auth real-time Google Autocomplete & Suggest
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# -----------------------------------------------------------------------------
# 5. Custom OAuth File Paths (Optional)
# -----------------------------------------------------------------------------
# Defaults: Looks for google-oauth.json or subsystem-specific files in root directory
# GOOGLE_OAUTH_PATH=./google-oauth.json
# GSC_OAUTH_PATH=./gsc-oauth.json
# GA4_OAUTH_PATH=./ga4-oauth.json
# GBP_OAUTH_PATH=./gbp-oauth.json
# GKP_OAUTH_PATH=./gkp-oauth.json
